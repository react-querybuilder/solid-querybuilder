{
  "name": "solid-querybuilder-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter solid-querybuilder build",
    "check": "bun run --filter solid-querybuilder check && bun run check:examples",
    "check:examples": "bun run --filter '@solid-querybuilder/example-*' check",
    "check:exports": "bun run --filter solid-querybuilder check:exports",
    "check:versions": "bun run --filter solid-querybuilder check:versions",
    "check:all": "bun run check:versions && bun run fmt:check && bun run build && bun run check && bun run check:exports && bun run lint && bun run test:coverage && bun run conformance && bun run test:ssr",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ssr": "bun run --filter solid-querybuilder test:ssr && bun run --filter @solid-querybuilder/example-ssr test:ssr",
    "conformance": "bun run --filter solid-querybuilder conformance"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.4",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "sass": "^1.108.2",
    "solid-js": "2.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vitest-axe": "^0.1.0"
  }
}
