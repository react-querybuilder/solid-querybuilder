{
  // Type-stripping only: `jsx: "preserve"` leaves JSX untouched and emits `.jsx`, no Babel
  // dependency and no second Solid compile. Declaration emission is handled separately by
  // `tsconfig.build.json`; type errors are gated separately by `bun run check`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": false,
    "declaration": false,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist/source",
    "types": ["solid-js"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test-d.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
